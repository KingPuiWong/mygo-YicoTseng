    { "title": "Official Live & Re-recordings", "page": "official", "icon": "note" },
    { "title": "Albums", "page": "albums", "icon": "album" },
    { "title": "All Songs", "page": "all", "icon": "note" },
    { "builtin": "liked" },
    { "builtin": "stations" }
  ]
